DATABASE_URL="postgresql://shelfos:shelfos_dev@localhost:55440/shelfos?schema=public"

# Mission Control shared access password. The gate fails CLOSED if this is
# unset — /mc/* is refused rather than left open.
MC_PASSWORD="change-me"
# Optional. Signs the session cookie; falls back to MC_PASSWORD if unset.
# Set this in production so rotating the password invalidates sessions
# independently of the signing key.
MC_SESSION_SECRET=""
